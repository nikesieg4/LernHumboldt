# ---------------------------------------------------------------
# Lernseite – Konfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ---------------------------------------------------------------

# Öffentliche Adresse der Lernseite (ohne / am Ende)
BASE_URL=https://lernen.meine-schule.de

# Nur für docker-compose/Caddy: die Subdomain (für das HTTPS-Zertifikat)
DOMAIN=lernen.meine-schule.de

# Name, der oben auf der Seite steht
SITE_NAME=Lernseite

# Langes, zufälliges Geheimnis zum Signieren der Login-Cookies.
# Erzeugen z. B. mit:  openssl rand -hex 32
SESSION_SECRET=bitte-aendern

# ---------------- IServ Single-Sign-On ----------------
# Adresse eures IServ (ohne / am Ende)
ISERV_URL=https://meine-schule.de
# Aus IServ: Verwaltung > System > Single-Sign-On > OAuth-Client
ISERV_CLIENT_ID=
ISERV_CLIENT_SECRET=

# IServ-Rollen, die als Lehrkraft gelten (kommagetrennt).
# Welche Rollen-IDs eure IServ liefert, siehst du nach dem ersten
# Login unter /admin (Spalte "IServ-Rollen").
TEACHER_ROLES=ROLE_TEACHER

# IServ-Benutzernamen oder E-Mails mit Admin-Rechten (kommagetrennt)
ADMIN_USERS=vorname.nachname

# true  = nur Schüler aus der Schülerliste dürfen sich anmelden
# false = jeder mit IServ-Konto darf sich anmelden
ROSTER_REQUIRED=true

# ---------------- Nur zum Testen ----------------
# true = zeigt einen Test-Login ohne IServ (NIEMALS im echten Betrieb!)
DEV_LOGIN=false

PORT=3000
